# Storage mode: "local" saves cards to disk, "bunny" uploads to BunnyCDN Storage
# Use "local" for development or self-hosted, "bunny" for serverless (e.g. Vercel)
STORAGE=local

# Unsplash API access key (server-side only)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# BunnyCDN Storage credentials (only needed if STORAGE=bunny)
BUNNY_USERNAME=gh-auto
BUNNY_HOSTNAME=sg.storage.bunnycdn.com
BUNNY_PORT=21
BUNNY_PASSWORD=your-bunny-password-here
